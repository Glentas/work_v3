# Все переменные необязательны — в скобках значения по умолчанию.

# Каталог с документами коллекции (.txt, .pdf)
COLLECTION_PATH=./collection

# Файл базы данных SQLite
DB_PATH=./data/search.db

# Сетевые параметры сервера.
# 0.0.0.0 — слушать все интерфейсы, чтобы к серверу могли подключаться
# другие компьютеры локальной сети.
APP_HOST=0.0.0.0
APP_PORT=8000

# Сколько документов показывать на странице выдачи (10)
PER_PAGE=10

# Длина фрагмента текста в выдаче, символов (300)
SNIPPET_LENGTH=300

# Сколько ключевых слов документа сохранять (5)
TOP_KEYWORDS=5

# Ограничение числа документов в одной выдаче (10000)
MAX_RESULTS=10000

# Сколько миллисекунд ждать снятия блокировки SQLite (15000).
# Важно при одновременной работе нескольких клиентов в локальной сети.
DB_BUSY_TIMEOUT_MS=15000

# Стратегия с отказами: 1 — ослаблять AND до OR при пустой выдаче, 0 — не ослаблять (1)
ENABLE_FALLBACK=1
