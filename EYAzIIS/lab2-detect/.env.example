# Все переменные необязательны — в скобках значения по умолчанию.

# Каталог с корпусом: train/, test/, stress/, sources/ (./corpus)
CORPUS_PATH=./corpus

# Каталог входных документов системы (./corpus/test)
TEST_PATH=./corpus/test

# Каталог стресс-наборов для сравнения методов (./corpus/stress)
STRESS_PATH=./corpus/stress

# Тренировочный набор: по одному файлу на язык (./corpus/train)
TRAIN_PATH=./corpus/train

# Файл нейросетевой модели fastText (./models/lid.176.ftz)
MODEL_PATH=./models/lid.176.ftz

# Сетевые параметры сервера. 0.0.0.0 — слушать все интерфейсы,
# чтобы к системе могли подключаться другие компьютеры локальной сети.
APP_HOST=0.0.0.0
APP_PORT=8000

# Размер профиля языка в методе N-грамм (300).
# В методичке: «примерно 300 самых частоиспользуемых N-грамм сильно зависят от языка».
NGRAM_PROFILE_SIZE=300

# Максимальная длина N-граммы (5). В методичке: «Значение N предлагается использовать равным 5».
NGRAM_MAX_N=5

# Размер входного документа в знаках видимого текста, ~1 страница А4 (2000).
DOC_CHARS=2000
