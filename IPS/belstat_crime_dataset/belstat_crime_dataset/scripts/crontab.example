# Пример расписания регулярного обновления датасета.
#
# Белстат публикует годовые данные по правонарушениям один раз в год
# (ориентировательно март–май за предыдущий год), поэтому чаще раза в неделю
# опрашивать портал смысла нет — это лишняя нагрузка на чужой сервер.
#
# Установка:  crontab -e   и добавить строку ниже (пути поправьте под себя).

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=""

# Каждый понедельник в 04:17 — полное обновление раздела «Правосудие и правонарушения».
17 4 * * 1  cd /home/user/belstat_crime_dataset && ./scripts/update_dataset.sh >> logs/cron.log 2>&1

# Альтернатива: только последние 6 лет, каждый день в 06:05 (дёшево и быстро).
# 5 6 * * *  cd /home/user/belstat_crime_dataset && ./scripts/update_dataset.sh 2020- >> logs/cron.log 2>&1
